{
  "name": "pchealth",
  "productName": "PC Health",
  "version": "0.8.0",
  "private": true,
  "description": "Offline, evidence-based computer health diagnostics",
  "author": "PC Health",
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/build-electron.mjs",
    "start": "electron .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.ts",
    "test:desktop": "node scripts/test-desktop.mjs",
    "package": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --publish never",
    "format": "prettier --write .",
    "test:dev": "node scripts/test-dev.mjs",
    "test:accessibility": "node scripts/test-accessibility.mjs",
    "test:investigations": "node scripts/test-investigations.mjs",
    "test:repairs": "node scripts/test-repairs.mjs",
    "test:reliability": "node scripts/test-reliability.mjs",
    "test:layout": "node scripts/test-layout.mjs",
    "vendor:prepare": "node scripts/prepare-vendor.mjs",
    "dist:mac": "npm run build && node scripts/package-mac.mjs",
    "dist:win": "npm run build && electron-builder --win nsis zip --x64 --publish never",
    "test:recovery": "node scripts/test-recovery.mjs",
    "install:local": "npm run build && node scripts/install-local.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.6",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.0"
  },
  "build": {
    "appId": "com.pchealth.desktop",
    "directories": {
      "output": "release/${version}"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "icon": "build/icon.png",
      "minimumSystemVersion": "13.0",
      "extraResources": [
        {
          "from": "vendor/darwin",
          "to": "vendor/darwin"
        }
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "build/icon.png",
      "extraResources": [
        {
          "from": "vendor/win32",
          "to": "vendor/win32"
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "icon": "build/icon.png"
    },
    "artifactName": "PC-Health-${version}-${os}-${arch}.${ext}",
    "extraResources": [
      {
        "from": "vendor/sources",
        "to": "vendor/sources"
      },
      {
        "from": "vendor/NOTICE.md",
        "to": "vendor/NOTICE.md"
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "PC-Health-${version}-windows-${arch}-Setup.${ext}",
      "allowElevation": false,
      "packElevateHelper": false
    },
    "afterPack": "scripts/after-pack.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
